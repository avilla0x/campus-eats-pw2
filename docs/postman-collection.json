{
  "info": {
    "name": "CampusEats API",
    "description": "Programación Web 2 · Semana 5: REST, validación y manejo centralizado de errores.\nAntes de usarla: npm run dev (http://localhost:3000). Se puede ejecutar completa con el Runner, en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "producto_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "CampusEats - Semana 5",
      "item": [
        {
          "name": "1. Operaciones CRUD",
          "item": [
            {
              "name": "Listar productos",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                      "pm.test('Trae datos y total', () => { const r = pm.response.json(); pm.expect(r.datos).to.be.an('array'); pm.expect(r).to.have.property('total'); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/productos",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "productos"
                  ]
                }
              }
            },
            {
              "name": "Obtener producto por id",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/productos/1",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "productos",
                    "1"
                  ]
                }
              }
            },
            {
              "name": "Crear producto",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                      "pm.collectionVariables.set('producto_id', pm.response.json().id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Nachos {{$timestamp}}\",\n  \"precio\": 3500,\n  \"stock\": 10\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/api/productos",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "productos"
                  ]
                },
                "description": "Guarda el id creado en {{producto_id}} para las peticiones siguientes."
              }
            },
            {
              "name": "Reemplazar producto (PUT)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre\": \"Nachos con queso {{$timestamp}}\",\n  \"precio\": 4000,\n  \"stock\": 8\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_url}}/api/productos/{{producto_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "productos",
                    "{{producto_id}}"
                  ]
                },
                "description": "PUT reemplaza el recurso completo: nombre, precio y stock son obligatorios."
              }
            },
            {
              "name": "Eliminar producto",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Responde 204', () => pm.response.to.have.status(204));",
                      "pm.test('Sin cuerpo', () => pm.expect(pm.response.text()).to.equal(''));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/productos/{{producto_id}}",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "productos",
                    "{{producto_id}}"
                  ]
                }
              }
            }
          ]
        },
