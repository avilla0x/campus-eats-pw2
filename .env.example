# Copia este archivo a .env y ajusta usuario/clave/puerto según tu contenedor
# (campuseats-db, usuario campuseats, base campuseats, puerto 5433 -> 5432)
DATABASE_URL="postgresql://campuseats:campuseats@localhost:5433/campuseats?schema=public"

# Semana 8: autenticación. JWT_SECRET es un secreto real en tu .env (nunca en git).
# Si cambias cualquiera de estos dos, reinicia el servidor: nodemon no recarga el .env.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRA="4h"
